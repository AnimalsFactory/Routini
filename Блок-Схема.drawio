        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Настройка сдержанной и профессиональной палитры\n    classDef main fill:#1e293b,stroke:#0f172a,stroke-width:1.5px,color:#ffffff;\n    classDef step fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px,color:#334155;\n    classDef action fill:#e2e8f0,stroke:#94a3b8,stroke-width:1.5px,color:#0f172a;\n\n    %% ЛЕВОЕ КРЫЛО: Инициализация и Архив\n    Start([Запуск Routini]) --&gt; Init[Инициализация: Hive + Montserrat]\n    Init --&gt; Dashboard\n    History[Архив и календарь прошлых дней] --&gt; Dashboard\n\n    %% ВЕРХНЕЕ КРЫЛО: Логика чекбоксов и прогресса\n    Dashboard --&gt; Toggle[Клик по чекбоксу: Смена статуса]\n    Toggle --&gt; SaveDb[Запись изменений в Hive]\n    SaveDb --&gt; UpdateProg[Пересчет полосы прогресса дня]\n    UpdateProg --&gt; Dashboard\n\n    %% ЦЕНТР СХЕМЫ\n    Dashboard[Центральный экран: Dashboard]\n\n    %% НИЖНЕЕ КРЫЛО: Модуль статистики\n    Dashboard --&gt; StatsScreen[Экран личной статистики]\n    StatsScreen --&gt; CalcMetrics[Расчет серий и % успеха]\n    CalcMetrics --&gt; Dashboard\n\n    %% ПРАВОЕ КРЫЛО: Конструктор привычек\n    Dashboard --&gt; CreateScreen[Экран создания привычки]\n    CreateScreen --&gt; InputData[Ввод названия, описания, дней]\n    InputData --&gt; CustomStyle[Выбор: 6 цветов + 10 иконок]\n    CustomStyle --&gt; SaveHabit[Локальный Push + Сохранение]\n    SaveHabit --&gt; Dashboard\n\n    %% Применение стилей\n    class Dashboard,CreateScreen,StatsScreen main;\n    class Start,Toggle,SaveHabit action;\n    class Init,History,InputData,CustomStyle,CalcMetrics,SaveDb,UpdateProg step;\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="SNafeGI9QJUw7yoKzPvn-190">
